# NEF: TIFF 6 structure (both byte orders), the tags the parser reads, the Nikon type-3
# MakerNote header, and the JPEG XS markers of the raw strip. libFuzzer dictionary format.

tiff_le="II*\x00"
tiff_be="MM\x00*"
off8_le="\x08\x00\x00\x00"
off8_be="\x00\x00\x00\x08"

# TIFF tag ids, little and big endian.
newsubfile_le="\xFE\x00"
newsubfile_be="\x00\xFE"
width_le="\x00\x01"
width_be="\x01\x00"
height_le="\x01\x01"
bps_le="\x02\x01"
bps_be="\x01\x02"
compression_le="\x03\x01"
compression_be="\x01\x03"
photometric_le="\x06\x01"
photometric_be="\x01\x06"
make_le="\x0F\x01"
make_be="\x01\x0F"
model_le="\x10\x01"
model_be="\x01\x10"
stripoff_le="\x11\x01"
stripoff_be="\x01\x11"
orientation_le="\x12\x01"
orientation_be="\x01\x12"
rows_le="\x16\x01"
rows_be="\x01\x16"
stripbytes_le="\x17\x01"
stripbytes_be="\x01\x17"
subifds_le="\x4A\x01"
subifds_be="\x01\x4A"
exififd_le="\x69\x87"
exififd_be="\x87\x69"
makernote_le="\x7C\x92"
makernote_be="\x92\x7C"
cfarepeat_be="\x82\x8D"
cfapattern_be="\x82\x8E"
cfa_photometric_le="\x23\x80"
cfa_photometric_be="\x80\x23"
nikon_compression_le="\x99\x87"
nikon_compression_be="\x87\x99"

# TIFF field types: BYTE ASCII SHORT LONG RATIONAL UNDEFINED.
type_short_be="\x00\x03"
type_long_be="\x00\x04"
type_rational_be="\x00\x05"
type_undefined_be="\x00\x07"
count1_be="\x00\x00\x00\x01"
count4_be="\x00\x00\x00\x04"

make="NIKON CORPORATION"
nikon="NIKON"
model_z6iii="NIKON Z6_3"
model_z8="NIKON Z 8"
model_zr="NIKON ZR"
makernote_head="Nikon\x00\x02\x11\x00\x00"
hlg="(HLG)"

# MakerNote tags (big endian): WB levels, colour space, picture control, black level,
# crop area, compression mode.
mn_wb="\x00\x0C"
mn_colorspace="\x00\x1E"
mn_picture_control="\x00\x23"
mn_black="\x00\x3D"
mn_crop="\x00\x45"
mn_compression="\x00\x51"
mode_he="\x0D\x00"
mode_he_star="\x0E\x00"

soc_cap="\xFF\x10\xFF\x50"
pih_head="\xFF\x12\x00\x27"
cdt_head="\xFF\x13\x00\x0E"
wgt="\xFF\x14"
slh_head="\xFF\x20\x00\x04"
eoc="\xFF\x11"
intopix="CONTACT_INTOPIX_"
